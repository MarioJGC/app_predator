# Copy this file to dev.env (git-ignored) and fill in. Used with:
#   flutter run --dart-define-from-file=config/dev.env
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key: safe inside the app. NEVER the secret/service_role key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Shows the test phone number and code on the login screen (dev only).
SHOW_TEST_LOGIN_HINT=true
